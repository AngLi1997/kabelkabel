{
  "name": "@kabel/editor",
  "version": "0.1.0",
  "description": "Kabel 档案著录工具主包：baseline 底座（工具栏 + 左右扩展面板 + 内容区 + 状态栏、文件目录与工作台）与宿主 API",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsup && node ../../scripts/build-css.mjs dist/style.css ../ui/src/styles/tokens.css ../ui/src/styles/base.css ../ui/src/styles/components.css ../ui/src/styles/shell.css ../ui/src/styles/settings.css ../ui/src/styles/overlays.css ../ui/src/styles/themes.css ../plugins/workspace/src/style.css ../plugins/region-select/src/style.css ../plugins/file-loader/src/style.css"
  },
  "dependencies": {
    "@kabel/core": "workspace:*",
    "@kabel/ui": "workspace:*",
    "@kabel/plugin-workspace": "workspace:*"
  }
}
