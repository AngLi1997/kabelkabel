{
  "name": "@kabel/ui",
  "version": "0.1.0",
  "description": "Kabel 渲染层：基于 Preact 的工作台外壳、布局插件与通用组件",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./style.css": "./dist/style.css",
    "./tailwind-preset": {
      "types": "./tailwind-preset.d.ts",
      "default": "./tailwind-preset.cjs"
    }
  },
  "files": [
    "dist",
    "tailwind-preset.cjs",
    "tailwind-preset.d.ts"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsup && node ../../scripts/build-css.mjs dist/style.css src/styles/tokens.css src/styles/base.css src/styles/components.css src/styles/shell.css"
  },
  "dependencies": {
    "@kabel/core": "workspace:*",
    "preact": "^10.29.0"
  }
}
