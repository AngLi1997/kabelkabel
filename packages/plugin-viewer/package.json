{
  "name": "@kabel/plugin-viewer",
  "version": "0.1.0",
  "description": "Kabel 影像查看插件：支持 URL、Base64、Blob、ArrayBuffer 等多种图片源，缩放、旋转、翻页、缩略图",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsup && node ../../scripts/build-css.mjs dist/style.css src/style.css"
  },
  "dependencies": {
    "@kabel/core": "workspace:*",
    "@kabel/ui": "workspace:*",
    "preact": "^10.29.0"
  }
}
