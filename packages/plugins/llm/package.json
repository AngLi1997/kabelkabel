{
  "name": "@kabel/plugin-llm",
  "version": "0.1.0",
  "author": "liang",
  "description": "Kabel 大模型服务（能力插件）：OpenAI 兼容接口，提供 LLM_SERVICE",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {
    "@kabel/core": "workspace:*"
  }
}
