{
  "name": "@kabel/plugin-market-supervision",
  "version": "0.1.0",
  "description": "Kabel 场景预设：市场监管档案加工（字段分组、框选识别回填、版面分析自动填充、数据对接）",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {
    "@kabel/core": "workspace:*",
    "@kabel/plugin-workspace": "workspace:*",
    "@kabel/plugin-region-select": "workspace:*",
    "@kabel/plugin-fields": "workspace:*",
    "@kabel/plugin-catalog": "workspace:*",
    "@kabel/plugin-ocr": "workspace:*",
    "@kabel/plugin-llm": "workspace:*",
    "@kabel/plugin-ocr-excerpt": "workspace:*",
    "@kabel/plugin-layout-extract": "workspace:*",
    "@kabel/plugin-data-exchange": "workspace:*"
  }
}
