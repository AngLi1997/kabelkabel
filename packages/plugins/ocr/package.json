{
  "name": "@kabel/plugin-ocr",
  "version": "0.1.0",
  "author": "liang",
  "description": "Kabel 文字识别服务（能力插件）：OpenAI 兼容接口（PaddleOCR-VL 等），提供 OCR_SERVICE",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {
    "@kabel/core": "workspace:*"
  }
}
