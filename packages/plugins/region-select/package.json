{
  "name": "@kabel/plugin-region-select",
  "version": "0.1.0",
  "description": "Kabel 框选插件：在影像舞台上框选区域（矩形、多边形，形状可扩展），并把原图与裁剪图通过事件交给下游",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsup && node ../../../scripts/build-css.mjs dist/style.css src/style.css"
  },
  "dependencies": {
    "@kabel/core": "workspace:*",
    "@kabel/plugin-workspace": "workspace:*",
    "@kabel/ui": "workspace:*",
    "preact": "^10.29.0"
  }
}
