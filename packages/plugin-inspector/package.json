{
  "name": "@kabel/plugin-inspector",
  "version": "0.1.0",
  "description": "Kabel 右侧辅助面板插件：校验结果与操作记录",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsup && node ../../scripts/build-css.mjs dist/style.css src/style.css"
  },
  "dependencies": {
    "@kabel/core": "workspace:*",
    "@kabel/ui": "workspace:*",
    "preact": "^10.29.0",
    "@kabel/plugin-metadata": "workspace:*"
  }
}
