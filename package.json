{
  "name": "kabel-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.6.0",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "pnpm --filter kabel-example-vue dev",
    "pack:all": "node scripts/pack-all.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "happy-dom": "^17.6.3",
    "preact": "^10.29.8",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "vitest": "^3.2.7",
    "vue": "^3.5.43"
  }
}
